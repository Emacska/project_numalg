    "#3 body: leapfrog method KDK\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "#constants\n",
    "G = 1  #make it easy for arbitrary body\n",
    "\n",
    "#position vectors at t = 0 (initial conditions set to arbitrary(\"simple\" to make check easier) values for my code)\n",
    "r1 = np.array([-0.5, 0.0, 0.0])  #body 1\n",
    "r2 = np.array([0.5, 0.0, 0.0])   #body 2\n",
    "r3 = np.array([5.0, 0.0, 0.0])   #body 3\n",
    "r = np.array([r1, r2, r3])\n",
    "\n",
    "#set arbitrary masses\n",
    "m = np.array([1.0, 2.0, 0.2])\n",
    "\n",
    "#set initial velocities to start the KDK (not too large so that they cant escape)\n",
    "v1 = np.array([0.0, 0.7, 0.0])\n",
    "v2 = np.array([0.0, -0.5, 0.0])\n",
    "v3 = np.array([0.0, 0.0, 1.0])\n",
    "v = np.array([v1, v2, v3])\n",
    "\n",
    "#velocity correction so that the centre of mass o fthe system stays at one point -> plot and read\n",
    "p = m[0]*v[0] + m[1]*v[1] + m[2]*v[2]\n",
    "vcm = p / (m[0] + m[1] + m[2])    # centre of mass velocity\n",
    "v = v - vcm\n",
    "\n",
    "#∆t\n",
    "dt = 0.001\n",
    "\n",
    "#outer acceleration function!!!\n",
    "def accelerations(r, m):\n",
    "    a = np.zeros_like(r)\n",
    "    for j in range(len(m)):\n",
    "        for k in range(j + 1, len(m)):\n",
    "            d = r[k] - r[j]\n",
    "            dcube = (np.linalg.norm(d))**3\n",
    "            a[j] += G * m[k] * (d/dcube)\n",
    "            a[k] -= G * m[j] * (d/dcube)\n",
    "    return a\n",
    "\n",
    "a = accelerations(r,m)\n",
    "\n",
    "#defining energy for energy conservation and erro rplot   (E = kin-pot)\n",
    "def energy(r, v, m):\n",
    "    kin = 0.0\n",
    "    for j in range(len(m)):     #kinetic energy\n",
    "        kin += 1/2 * m[j] * (np.linalg.norm(v[j]))**2\n",
    "\n",
    "    pot = 0.0\n",
    "    for j in range(len(m)):   #potntial energy \n",
    "        for k in range(j + 1, len(m)):\n",
    "            pot += G * (m[j]*m[k]) / np.linalg.norm(r[k] - r[j])\n",
    "\n",
    "    ener = kin - pot \n",
    "    return ener\n",
    "\n",
    "\n",
    "#storing data for the energy calculation later\n",
    "positions = [r.copy()]\n",
    "velocities = [v.copy()]\n",
    "\n",
    "#main loop and KDK implementation (half kick -> drift -> half kick)\n",
    "n_steps = 10000\n",
    "\n",
    "for i in range(n_steps):\n",
    "    v += a * dt / 2   #half kick I\n",
    "    r += v *dt        #drift\n",
    "    a = accelerations(r,m)    #new a due to new positions(acceleration only depends on position)\n",
    "    v += a * dt / 2   #half kick II\n",
    "    positions.append(r.copy())\n",
    "    velocities.append(v.copy())\n",
    "\n",
    "#turn positions & velocities to array to use for energy \n",
    "positions = np.array(positions)\n",
    "velocities = np.array(velocities)\n",
    "\n",
    "#energy loop for comparison and plot\n",
    "energies = []\n",
    "for i in range(n_steps + 1):\n",
    "    En = energy(positions[i], velocities[i], m)\n",
    "    energies.append(En)\n",
    "energies = np.array(energies)    \n",
    "\n",
    "#relative error\n",
    "E0 = energies[0]\n",
    "diff = energies - E0\n",
    "e_rel = diff / E0\n",
    "e_rel = np.abs(e_rel)\n",
    "\n",
    "\n",
    "\n",
    "\n",
